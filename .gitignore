.ipynb_checkpoints/
*.pyc
.DS_Store
.env

# Logi i Cache
cache/
logs/

# DANE (ŚCISŁA IZOLACJA)
# Całkowicie blokujemy folder data. Zawiera on dziesiątki gigabajtów 
# rozpakowanych plików GTFS (.txt), bazy GPKG, PBF, SQLite,
# pliki sieci drogowych (.graphml) oraz lokalne zrzuty JSON.
# Żadne dane przetwarzane nie mają prawa trafić do repozytorium kodu.
data/

# RAPORTY
# Ignorujemy archiwum, ale śledzimy ostateczne pliki audytowe
reports/archive/
reports/visuals/*.html

# Frontend (urban-dashboard)
urban-dashboard/node_modules/
urban-dashboard/.next/
urban-dashboard/out/
urban-dashboard/dev.log*
urban-dashboard/.dev.pid
urban-dashboard/*.tsbuildinfo
urban-dashboard/next-env.d.ts

# Archiwa i pliki tymczasowe
scripts/archive_temp/
*.zip
entities.json
.pytest_cache/
.ruff_cache/
.coverage
*.egg-info/

# GWARANCJA ŚLEDZENIA KODU I KONFIGURACJI
